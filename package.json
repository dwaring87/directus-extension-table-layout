{
	"name": "directus-extension-table-layout",
	"description": "A layout to view seating assignments at tables",
	"icon": "table_bar",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-layout"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "layout",
		"path": "dist/index.js",
		"source": "src/index.js",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.0.11",
		"vue": "^3.5.30"
	}
}
